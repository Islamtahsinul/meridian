# Meridian settings. Copy to .env (same folder as server.py) and fill in what you want.
# Everything is optional: Meridian works with no keys at all, with less coverage.
# Keys stay on this computer; the browser only learns whether each one is set.
# Restart Meridian after editing.

# Server (loopback only; any other host is refused)
# MERIDIAN_HOST=127.0.0.1
# MERIDIAN_PORT=8790
# MERIDIAN_DATA_DIR=
# Days of event history to keep (1 to 90)
# MERIDIAN_HISTORY_DAYS=30


# ---- ai
# Anthropic API key for the Ask assistant (Claude). Questions, the map view and tool results are sent to Anthropic. (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# Which assistant answers questions: auto (Claude when ANTHROPIC_API_KEY is set, otherwise Ollama when it is running), anthropic, ollama or off.
# AI_PROVIDER=
# How much Claude thinks before answering: low (fastest and cheapest), medium (default), high, xhigh or max.
# ANTHROPIC_EFFORT=
# When Claude's safety filter declines a question, let Anthropic retry it on its recommended fallback model: on (default) or off. (https://platform.claude.com/docs/en/build-with-claude/refusals-and-fallback)
# ANTHROPIC_FALLBACK=
# Claude model for the assistant. Default claude-opus-5-5 (most capable, $4 / $20 per million input / output tokens). Cheaper: claude-sonnet-5-5 ($2 / $10) or claude-haiku-5-5 ($0.10 / $0.50). (https://platform.claude.com/docs/en/about-claude/models/overview)
# ANTHROPIC_MODEL=
# Ollama model with tool support, for example qwen3:8b or llama3.1:8b. Default: the first suitable model installed. (https://ollama.com/search?c=tools)
# OLLAMA_MODEL=
# Local Ollama server for free, offline answers. Must be on this computer; default http://127.0.0.1:11434. (https://ollama.com/download)
# OLLAMA_URL=

# ---- briefing
# Local time (24-hour HH:MM) after which the daily briefing is made, once a day. Default 07:00.
# BRIEFING_TIME=

# ---- cameras
# 511 Alberta developer key: adds Alberta highway cameras. (https://511.alberta.ca/developers/doc)
ALBERTA511_KEY=
# Arizona 511 cameras key: adds Arizona highways, Phoenix and Tucson. (https://az511.com/developers/doc)
AZ511_KEY=
# HAC motorway cameras key: adds Croatian motorways A1 to A11, including the Istrian Y. (https://www.promet-info.hr/en/datasets_details?id=504c9423-f558-4cbf-84e4-3ac9f0d892b1)
CROATIA_NAP_KEY=
# CTroads cameras key: adds Connecticut interstates and highways. (https://ctroads.org/developers/doc)
CT511_KEY=
# Georgia 511 cameras key: adds Georgia interstates and metro Atlanta. (https://511ga.org/developers/doc)
GA511_KEY=
# Idaho 511 cameras key: adds Idaho highways and mountain passes. (https://511.idaho.gov/developers/doc)
ID511_KEY=
# Louisiana 511 cameras key: adds Louisiana interstates, New Orleans and Baton Rouge. (https://511la.org/developers/doc)
LA511_KEY=
# Manitoba 511 cameras key: adds Manitoba highways. (https://www.manitoba511.ca/developers/doc)
MB511_KEY=
# New Brunswick 511 cameras key: adds New Brunswick highways. (https://511.gnb.ca/developers/doc)
NB511_KEY=
# DriveNC cameras key: adds North Carolina interstates and highways. (https://www.drivenc.gov/developers/doc)
NC511_KEY=
# North East England UTMC cameras key: adds Tyne and Wear, Northumberland, the Tyne Tunnel and North East road weather stations. (https://www.netraveldata.co.uk/?page_id=42)
NETRAVELDATA_KEY=
# US National Park Service API key (free): adds national park webcams. (https://www.nps.gov/subjects/developer/get-started.htm)
NPS_API_KEY=
# Nevada 511 cameras key: adds Nevada highways, Las Vegas and Reno. (https://www.nvroads.com/developers/doc)
NV511_KEY=
# 511NY developer key: adds New York State traffic cameras. (https://511ny.org/developers/doc)
NY511_KEY=
# OHGO cameras key: adds Ohio interstates and city freeways. (https://publicapi.ohgo.com/)
OHGO_KEY=
# Ontario 511 developer key: adds Ontario highway cameras. (https://511on.ca/developers/doc)
ONTARIO511_KEY=
# Ottawa traffic cameras key: adds City of Ottawa. (https://traffic.ottawa.ca/en/traffic-map-data-lists-and-resources/about-the-data)
OTTAWA_CAMERA_KEY=
# QLDTraffic API key (optional): replaces the shared public key, which is often over its quota, for Queensland road cameras. Request one from QLDTraffic@tmr.qld.gov.au. (https://qldtraffic.qld.gov.au/more/Developers-and-Data/index.html)
QLDTRAFFIC_KEY=
# SANRAL i-traffic cameras key: adds Gauteng, Western Cape, KwaZulu-Natal and Eastern Cape freeways. (https://www.i-traffic.co.za/developers/doc)
SANRAL_ITRAFFIC_KEY=
# Slovenia road cameras key: adds Slovenian motorways and main state roads. (https://www.nap.si/en/datasets_details?id=e5e4ee6a-48f3-3ca4-9d11-71596ee6154c)
SLOVENIA_NAP_KEY=
# Trafikverket road cameras key: adds Swedish state roads (road condition and traffic flow cameras). (https://data.trafikverket.se/)
TRAFIKVERKET_KEY=
# UDOT Traffic cameras key: adds Utah highways and canyons. (https://www.udottraffic.utah.gov/developers/doc)
UT511_KEY=
# 511 Wisconsin cameras key: adds Wisconsin interstates and highways. (https://511wi.gov/developers/doc)
WI511_KEY=
# Windy Webcams API key (free tier): adds about 69,000 webcams worldwide (catalogue crawled weekly, pictures loaded from Windy). (https://api.windy.com/keys)
WINDY_WEBCAMS_KEY=
# WSDOT highway cameras key: adds Washington State highways, passes and ferry terminals. (https://wsdot.wa.gov/traffic/api/)
WSDOT_KEY=
# 511 Yukon cameras key: adds Yukon highways. (https://511yukon.ca/developers/doc)
YT511_KEY=
# Camera sources to skip, as comma-separated ids (for example nyc,autobahn).
# CAMERAS_DISABLE=
# Build only these camera sources (comma-separated ids). For development; leave unset.
# CAMERAS_ONLY=

# ---- flights
# adsb.lol API key. Without one adsb.lol allows 500 metered requests a day, so it is only a fallback. (https://www.adsb.lol/docs/open-data/api/)
ADSBLOL_API_KEY=
# OpenSky Network API client id. With the secret it raises OpenSky's daily allowance from 400 to 4,000 credits. (https://opensky-network.org/my-opensky/account)
OPENSKY_CLIENT_ID=
# OpenSky Network API client secret (pairs with OPENSKY_CLIENT_ID). (https://opensky-network.org/my-opensky/account)
OPENSKY_CLIENT_SECRET=
# Set to 0 to stop sampling favourited airports (up to 6, one small request each every 10 min) for the airport movement baselines.
# FLIGHTS_AIRPORT_WATCH=
# Set to 0 to stop the background GPS interference sampler (16 hotspots, every 5 min while you use Meridian, every 10 min otherwise).
# FLIGHTS_GPSJAM_SAMPLER=
# Set to 0 to keep no aircraft history (timeline replay then shows no aircraft).
# FLIGHTS_HISTORY=
# Most aircraft samples kept for timeline replay (default 2,000,000, about 100 MB); the oldest go first.
# FLIGHTS_HISTORY_MAX_ROWS=
# Set to 0 to stop the background military snapshot (the worldwide military list every 10 min, 144 small requests a day) that the military surge baselines need.
# FLIGHTS_MIL_SAMPLER=
# Order of live sources for map tiles, default adsbfi,adsblol,opensky.
# FLIGHTS_PROVIDERS=
# Your own receiver's aircraft.json (readsb or tar1090), for example http://10.0.0.20/tar1090/data/aircraft.json. (https://github.com/wiedehopf/tar1090)
# LOCAL_ADSB_URL=

# ---- hazards
# NASA FIRMS map key (free). Uses the FIRMS area API for active fires; without it the public 24-hour files are used. (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
# Keep a slow refresh of earthquakes, disasters, storms, tsunami messages and outbreaks when no browser is open, so the AI and convergences stay current (default on).
# HAZARDS_BACKGROUND=
# Fire satellites to load: noaa20, noaa21, snpp, modis (default noaa20,snpp,modis; each VIIRS file is about 8 MB a day).
# HAZARDS_FIRMS_SATELLITES=
# MeteoAlarm countries for weather warnings, by feed name or ISO code (default all 39; Germany and Switzerland are the largest feeds). (https://feeds.meteoalarm.org/)
# HAZARDS_METEOALARM_COUNTRIES=

# ---- infra
# Delayed share prices for US-listed companies on company cards and the markets drawer (free key). (https://finnhub.io/register)
FINNHUB_API_KEY=
# Delayed share prices and fund prices (free key, 800 requests a day). (https://twelvedata.com/pricing)
TWELVEDATA_API_KEY=
# Download link of the NGA World Port Index CSV, if NGA publishes a new edition. (https://msi.nga.mil/Publications/WPI)
# INFRA_WPI_URL=

# ---- intel
# Cloudflare Radar API token: adds verified traffic anomalies, outage reports, BGP hijacks and route leaks to the cyber layer and country cards. (https://developers.cloudflare.com/radar/get-started/first-request/)
CLOUDFLARE_RADAR_TOKEN=
# UCDP API token, only used if the public GED download stops working. (https://ucdp.uu.se/apidocs/)
UCDP_ACCESS_TOKEN=
# Hours of GDELT history fetched at first start (1-72, default 48). (https://www.gdeltproject.org/data.html)
# INTEL_BACKFILL_HOURS=
# Days of GDELT history fetched once for the news-spike baseline (0-30, default 16, about 6 MB a day). (https://www.gdeltproject.org/data.html)
# INTEL_SEED_DAYS=
# Download limit of that one-off history seed in MB (default 150). (https://www.gdeltproject.org/data.html)
# INTEL_SEED_MAX_MB=

# ---- ships
# aisstream.io API key. Adds live AIS from community receivers worldwide (without it, ships cover Finnish waters and the northern Baltic only). (https://aisstream.io/apikeys)
AISSTREAM_API_KEY=
# What to subscribe to on aisstream.io: world (default), straits (only the monitored straits, far less traffic) or your own boxes as west,south,east,north;west,south,east,north. (https://aisstream.io/documentation)
# AISSTREAM_AREA=
# Set to 1 to read the Norwegian Coastal Administration's open AIS stream (raw NMEA on TCP 153.44.253.27:5631, Norwegian waters). Some networks block it. (https://www.kystverket.no/en/navigation-and-monitoring/ais/access-to-ais-data/)
# KYSTVERKET_AIS=
# Most vessel track points kept (72 hours, for cards and timeline replay; default 2,500,000); the oldest go first.
# SHIPS_HISTORY_MAX_ROWS=
# Set to 0 to stop fetching IMF PortWatch's daily chokepoint transits (about 30 small requests a week to services9.arcgis.com). (https://portwatch.imf.org/)
# SHIPS_PORTWATCH=
